# Top-level .gitignore — covers the repo as a whole.
# Per-package ignores live inside each folder (e.g. frontend/.gitignore).

# OS / editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files (never commit credentials)
.env
.env.*
!.env.example
!.env.*.example
!*.env.example

# npm workspaces — node_modules at any depth
node_modules/

# Terraform (when infra/ is added)
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Lambda build artifacts (when backend/ is added)
# dist* covers the per-Lambda esbuild bundles: dist/ (shop-api + email-fn),
# dist-scheduler/ (scheduler-fn), dist-assets/ (assets-fn). Terraform rebuilds
# them from source before `apply`, so the minified output never belongs in git.
backend/**/dist*/
backend/**/build/
backend/**/*.zip

# Local smoke-test scratch files (the README curl recipes create these — JSON
# request bodies and a saved session cookie; never commit a cookie/session token)
cookies.txt
body.json
patch.json
del.json
f.json

# Logs
*.log
