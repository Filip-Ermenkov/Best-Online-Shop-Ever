# Frontend environment. Copy to .env.local and adjust.

# Where shop-api is running. The default matches `npm run api:dev`.
NEXT_PUBLIC_SHOP_API_URL=http://localhost:3001

# Absolute URL the public site is served from. Used by Next.js to resolve
# relative canonical / OG-image / Twitter-image URLs declared in page
# metadata (`src/app/layout.tsx` → `metadataBase`). The fallback only
# matters during pure local dev — production builds should set this to
# the real https origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Image-upload pipeline CSP allowances (roadmap item 46) ─────────────────
# Only needed when testing/using the direct-to-S3 image upload. The strict CSP
# (src/proxy.ts) must allow the browser to POST to the S3 bucket (connect-src)
# and to render promoted images from the assets CDN (img-src). Leave empty when
# uploads are disabled. Values = terraform outputs `assets_bucket` (as its
# https://<bucket>.s3.<region>.amazonaws.com endpoint) and `assets_cdn_url`.
# NEXT_PUBLIC_ASSET_S3_ORIGIN=https://<bucket>.s3.eu-central-1.amazonaws.com
# NEXT_PUBLIC_ASSET_CDN_ORIGIN=https://<dist>.cloudfront.net
