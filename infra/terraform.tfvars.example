# Copy to terraform.tfvars and edit. NEVER put the Neon URL or any secret here —
# DATABASE_URL is set out-of-band in SSM after the first apply (see README).
# terraform.tfvars is gitignored; this .example is the committed template.
#
# Filled in for the duda1.shop PRODUCTION deploy (roadmap item 17). Before you
# apply: build the four Lambda bundles (see the per-section notes), and set
# adot_collector_layer_arn + confirm alarm_email. See infra/GO-LIVE.md.

# ─── Identity ────────────────────────────────────────────────────────────────
project     = "best-online-shop"
environment = "prod"
aws_region  = "eu-central-1"

# ─── Runtime config injected into the Lambda (all non-secret) ────────────────
cors_origins                = "https://duda1.shop"
public_app_base_url         = "https://duda1.shop"
email_from                  = "Best Online Shop <noreply@duda1.shop>"
email_transport             = "sqs"  # prod target: durable queue + retry (needs enable_email_queue)
log_level                   = "info" # required by enable_slo_alarms (SLIs read the INFO request_end line)
cdn_base_url                = ""     # leave empty → auto-set to the assets CDN (enable_asset_uploads)
lambda_architecture         = "arm64" # Graviton: ~20% cheaper/faster. The ADOT layer below MUST be arm64.
lambda_reserved_concurrency = -1     # unreserved (safest on small accounts); set a real cap after a quota raise

# ─── Edge (CloudFront) ───────────────────────────────────────────────────────
enable_cdn      = true
api_domain_name = "shop-api.duda1.shop" # same registrable site as the storefront → same-site cookies
enable_waf      = false                 # Cloudflare's free WAF fronts it instead (§10)

# ─── DNS ─────────────────────────────────────────────────────────────────────
# DNS lives in Cloudflare (free, stronger DDoS, apex CNAME-flattening). Terraform
# does NOT manage Route53; publish the records emitted by `terraform output`
# (cert validation, the API CNAME, SES DKIM/DMARC) in the Cloudflare dashboard.
enable_dns       = false
root_domain_name = "duda1.shop" # informational when enable_dns = false

# ─── Frontend (Next.js 16 via OpenNext, roadmap item 17) ─────────────────────
# Build the bundle BEFORE applying with this on:
#   cd frontend && npx open-next@latest build   (details in infra/frontend.tf header)
# The frontend ACM cert is validated in two steps — also in that header.
enable_frontend      = true
frontend_domain_name = "duda1.shop"
frontend_include_www = false # true → also serve + redirect www.duda1.shop

# ─── Amplify (DEPRECATED — superseded by OpenNext above; keep off) ───────────
enable_amplify = false

# ─── Email sending (SES) ─────────────────────────────────────────────────────
# Publish the 3 DKIM CNAMEs + MAIL FROM + DMARC (terraform outputs) in Cloudflare,
# then request SES production access in the console.
enable_ses = true
ses_domain = "duda1.shop"

# ─── Durable email queue (SQS + email-fn, roadmap item 21) ───────────────────
# Build the bundle BEFORE applying: npm --workspace @shop/email run build:lambda
enable_email_queue = true

# ─── CI/CD (GitHub OIDC deploy role) ─────────────────────────────────────────
enable_github_oidc = true
github_owner       = "Filip-Ermenkov"
github_repo        = "Best-Online-Shop-Ever"
github_deploy_ref  = "refs/heads/main"

# ─── Observability ───────────────────────────────────────────────────────────
alarm_email             = "info@duda1.shop" # confirm the SNS subscription email AWS sends
enable_admin_alarms     = false             # turn on once a dedicated admin-api exists
enable_scheduler_alarms = true

# ─── SLOs + burn-rate alerting (roadmap items 24/25) ─────────────────────────
# Requires log_level = "info" (set above). Composite alarms bill $0.50/mo each.
enable_slo_alarms = true

# ─── Scheduled jobs (scheduler-fn, roadmap item 23) ──────────────────────────
# Build the bundle BEFORE applying: npm --workspace @shop/api run build:scheduler
enable_scheduler = true

# ─── Image uploads (assets-fn pipeline, roadmap item 46) ─────────────────────
# Build the bundle BEFORE applying: npm --workspace @shop/api run build:assets
# asset_cors_allowed_origins = the BROWSER PAGE origin (the storefront), NOT the CDN.
enable_asset_uploads       = true
asset_cors_allowed_origins = ["https://duda1.shop"]

# ─── Cost / security knobs ───────────────────────────────────────────────────
enable_kms_cmk      = true
enable_xray_tracing = true

# ─── Distributed tracing (OpenTelemetry / ADOT, roadmap item 18) ─────────────
# enable_tracing = true with an empty layer ARN = log↔trace correlation only.
# To EXPORT to X-Ray, set adot_collector_layer_arn to the latest ARM64 collector
# layer (must match lambda_architecture = "arm64"):
#   https://github.com/aws-observability/aws-otel-lambda
enable_tracing           = true
adot_collector_layer_arn = "" # e.g. "arn:aws:lambda:eu-central-1:901920570463:layer:aws-otel-collector-arm64-ver-0-117-0:1"
