# Copy to .env and fill in. .env is gitignored.

# Local development (Docker Compose Postgres):
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# Production (Neon serverless driver). Use the *pooled* connection string — the
# suffix usually contains "-pooler". Ordinary queries go over a stateless HTTPS
# fetch and interactive transactions over a short-lived WebSocket, so PgBouncer
# transaction-mode pooling is the right backend. (The runtime strips
# channel_binding for the WebSocket path — see docs/ARCHITECTURE.md §13.)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/shop?sslmode=require
