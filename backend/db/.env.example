# Copy to .env and fill in. .env is gitignored.

# Local development (Docker Compose Postgres):
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# Production (Neon HTTP driver). Use the *pooled* connection string — the suffix
# usually contains "-pooler". The HTTP driver does not maintain TCP connections,
# so PgBouncer transaction-mode pooling is the right backend.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/shop?sslmode=require
