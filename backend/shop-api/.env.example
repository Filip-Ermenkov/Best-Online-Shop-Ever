# shop-api environment.

# Local dev — Docker Postgres (same instance as @shop/db).
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# Where the API listens locally.
PORT=3001

# CORS allowlist (comma-separated). Use the frontend dev origin during local dev.
CORS_ORIGINS=http://localhost:3000

# CDN base URL for product images (the CloudFront/R2 origin in front of the
# assets bucket). Empty in dev — the frontend renders placehold.co placeholders.
# On a deploy with enable_asset_uploads=true, Terraform points this at the new
# assets CloudFront distribution automatically (infra/lambda.tf).
CDN_BASE_URL=

# Logging — "info" in dev, "warn" or "error" in production. "silent" in tests.
# NOTE: the SLO metric filters (infra/slo.tf) read the INFO-level `request_end`
# line, so a deployed Lambda with enable_slo_alarms=true must run at "info"
# (a Terraform precondition enforces this).
LOG_LEVEL=info

# ─── Email (verification + future transactional templates) ──────────────────
# Transport — "console" logs to stdout (default for local dev), "ses" uses
# AWS SESv2, "stub" is the in-memory recorder used by the test suite.
EMAIL_TRANSPORT=console

# Verified sender. Must match a verified identity in SES when EMAIL_TRANSPORT=ses.
EMAIL_FROM=Best Online Shop <noreply@example.com>

# AWS region for SES (eu-central-1 = Frankfurt, GDPR posture).
EMAIL_AWS_REGION=eu-central-1

# Optional SES configuration set name. Use to wire bounces/complaints to SNS
# when the suppression-list slice ships. Empty string = not used.
EMAIL_CONFIGURATION_SET=

# Public URL of the frontend, used to build clickable links in email bodies:
#   ${PUBLIC_APP_BASE_URL}/account/verify-email?token=...
#   ${PUBLIC_APP_BASE_URL}/track/<token>   (guest order-tracking link)
PUBLIC_APP_BASE_URL=http://localhost:3000

# FALLBACK public shop phone. Superseded by the admin-editable `store_phone`
# setting (settings slice, roadmap item 48): the guest tracking page + the
# ready-for-pickup email read the setting first and fall back to this only when
# it is blank. Empty = no phone unless the setting provides one.
SHOP_CONTACT_PHONE=

# ─── Image uploads (assets-fn pipeline, roadmap item 46) ────────────────────
# Empty in dev — POST /admin/uploads then returns 503 (uploads disabled) and the
# catalog still renders with placeholders. On a deploy with
# enable_asset_uploads=true, Terraform sets ASSET_UPLOAD_BUCKET (+ CDN_BASE_URL).
# S3 bucket the presigned POST targets and the validator promotes within.
ASSET_UPLOAD_BUCKET=
# Region of that bucket (eu-central-1 = Frankfurt, GDPR posture).
ASSET_AWS_REGION=eu-central-1
# Hard cap on a single uploaded image, in bytes (default 10 MiB). Enforced in the
# route AND the S3 POST policy's content-length-range.
ASSET_UPLOAD_MAX_BYTES=10485760
# Lifetime of a minted presigned POST, in seconds (default 5 minutes).
ASSET_UPLOAD_URL_TTL_SECONDS=300

# ─── Distributed tracing (OpenTelemetry, roadmap item 18) ───────────────────
# Off by default; when off the OTel graph is never evaluated (zero cost).
# Set to "true" to emit request + fetch spans and stamp trace_id/span_id onto
# every log line. Try it locally with the console exporter below.
ENABLE_TRACING=false
# Where spans go when ENABLE_TRACING=true: "none" (spans + log correlation, no
# export — safe default), "console" (print spans to stdout — the local demo),
# or "otlp" (send to OTEL_EXPORTER_OTLP_ENDPOINT; in prod that's the ADOT
# collector layer on http://localhost:4318, which forwards to AWS X-Ray).
OTEL_TRACES_EXPORTER=none
# Standard OTel endpoint the OTLP exporter reads when OTEL_TRACES_EXPORTER=otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Admin MFA (TOTP) ───────────────────────────────────────────────────────
# These gate ONLY the /admin/* surface; the storefront boots fine without them
# (an unset key fails closed on admin routes only). Generate a fresh pair with:
#   npm --workspace @shop/api run admin:create -- --print-keys
# In production store both as SSM SecureString parameters, never in the repo.
#
# Base64 32-byte (AES-256) key — encrypts the TOTP secret at rest (AES-256-GCM).
ADMIN_MFA_ENCRYPTION_KEY=
# HMAC key for the short-lived login→TOTP challenge tokens. Any long random str.
ADMIN_MFA_CHALLENGE_KEY=
# Issuer label shown in the admin's authenticator app + otpauth:// URI.
ADMIN_MFA_ISSUER=Best Online Shop (Admin)

# Production (Lambda + Neon HTTP). Same DATABASE_URL pattern as @shop/db.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/shop?sslmode=require
#
# Production email — set EMAIL_TRANSPORT=ses, EMAIL_FROM to your verified
# domain identity, and complete the SES DNS prerequisites BEFORE going live:
#   - DKIM (3 CNAMEs published, all verified in the SES console)
#   - Custom MAIL FROM (subdomain like mail.shop.example.com)
#   - DMARC TXT record at _dmarc.shop.example.com (start with p=none)
#   - Move the SES account out of sandbox (Service Quotas → SES → request)

# Note: the one-time admin bootstrap reads ADMIN_EMAIL + ADMIN_PASSWORD, but
# pass those transiently to `npm --workspace @shop/api run admin:create` (env or
# --email/--password flags) rather than committing them here. They are NOT
# runtime config and intentionally have no entry in this template.