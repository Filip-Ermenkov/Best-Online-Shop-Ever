{
  "name": "@shop/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for the shop. Same Hono app runs on AWS Lambda (production) and Node (local dev).",
  "type": "module",
  "main": "./src/handler.ts",
  "exports": {
    ".": "./src/types.ts",
    "./handler": "./src/handler.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "job": "tsx src/jobs/cli.ts",
    "build:lambda": "node build.mjs",
    "build:scheduler": "node build-scheduler.mjs",
    "build:assets": "node build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'add eslint when shared config lands'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-presigned-post": "^3.1079.0",
    "@hono/otel": "^1.1.2",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/node-server": "^2.0.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-undici": "^0.30.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@shop/auth": "*",
    "@shop/db": "*",
    "@shop/email": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "pino": "^10.3.1",
    "pino-lambda": "^4.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "pg": "^8.22.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
